---
import Brackets from "./Brackets.astro";
---

<section id="hero" class="hero" data-hero>
  <div class="hero-image" data-hero-image>
    <video
      src="/video/hero.mp4"
      poster="/video/hero-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Μπουρτζίλας Οικοδομές, παρουσίαση έργων"
    ></video>
    <div class="hero-veil"></div>
  </div>

  <!-- insetTop clears the fixed topbar (~5rem tall) -->
  <Brackets inset="2.5rem" insetTop="6.5rem" size="6rem" stroke="1px" color="var(--canvas)" />

  <div class="hero-content">
    <span class="hero-eyebrow" data-reveal>
      <span class="line"></span>
      <span>Δημιουργούμε χώρους Από το 1995</span>
    </span>

    <h1 class="hero-title" data-split-title>
      <span class="line">ΚΑΙΝΟΤΟΜΗ ΚΑΤΑΣΚΕΥΗ</span>
    </h1>

    <p class="hero-lede" data-reveal>
      MPOURTZILAS. Δημιουργούμε χώρους με ακρίβεια, καινοτομία και αισθητική.
      Εξειδικευόμαστε στο να μετατρέπουμε το όραμά σας σε πραγματικότητα.
    </p>

    <div class="hero-actions" data-reveal>
      <a class="btn-outline" href="/projects">ΤΑ ΕΡΓΑ ΜΑΣ</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--black);
    color: var(--canvas);
    display: flex;
    align-items: flex-end;
    /* bottom padding matches the horizontal padding so the button sits the
       same distance from the bottom as from the left edge */
    padding: clamp(3.5rem, 8vw, 7rem) clamp(2rem, 6vw, 6rem) clamp(2rem, 6vw, 6rem);
  }

  .hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .hero-image img,
  .hero-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);          /* GSAP releases to 1.0 over the load */
    filter: contrast(1.05) saturate(0.85) brightness(0.78);
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(110deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.18) 55%, rgba(0,0,0,0.05) 100%),
      linear-gradient(0deg, rgba(0,0,0,0.45), rgba(0,0,0,0.0) 35%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: none;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 clamp(1rem, 2vw, 1.5rem) 0;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--canvas);
    text-transform: uppercase;
  }
  .hero-eyebrow .line {
    width: 3rem;
    height: 1px;
    background: var(--canvas);
    transform-origin: left center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.65rem, 3.8vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: clamp(0.2rem, 0.8vw, 0.5rem);
    text-transform: uppercase;
    color: var(--canvas);
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem) 0;
    width: 100%;
    white-space: nowrap;
  }
  .hero-title .line {
    display: inline;
    overflow: hidden;
  }
  .hero-title em {
    font-weight: 300;
    letter-spacing: 0.5rem;
    color: var(--bronze);
  }

  .hero-lede {
    max-width: 48rem;
    font-size: 1.2rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.82);
    margin: 0 0 clamp(2rem, 4vw, 3rem) 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--canvas);
    opacity: 0.75;
    transition: opacity 0.4s var(--ease-arch);
  }
  .hero-scroll:hover { opacity: 1; }
  .hero-scroll svg { color: var(--bronze); }
  .hero-scroll .dot {
    animation: scroll-dot 2.4s var(--ease-arch) infinite;
  }
  @keyframes scroll-dot {
    0%   { transform: translateY(0);     opacity: 1;  }
    50%  { transform: translateY(14px);  opacity: 0.2; }
    100% { transform: translateY(0);     opacity: 1;  }
  }

  @media (max-width: 900px) {
    .hero {
      height: auto;
      min-height: 72svh;
      padding: 5.5rem clamp(1.25rem, 5vw, 2rem) 2.5rem;
    }
    .hero-title {
      font-size: clamp(1.4rem, 5.5vw, 2.25rem);
      letter-spacing: clamp(0.1rem, 0.8vw, 0.35rem);
      margin-bottom: 1.25rem;
    }
    .hero-lede {
      font-size: 1rem;
      line-height: 1.65;
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 78svh;
      padding-top: 5rem;
      padding-bottom: 2rem;
    }
    .hero-eyebrow {
      font-size: 0.625rem;
      letter-spacing: 0.12rem;
      line-height: 1.4;
      flex-wrap: nowrap;
      margin-top: 0;
      margin-bottom: 0.85rem;
    }
    .hero-eyebrow .line {
      width: 2rem;
      flex-shrink: 0;
    }
    .hero-title {
      font-size: clamp(1.25rem, 5vw, 1.75rem);
      letter-spacing: 0.08rem;
    }
    .hero-lede {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 700px) {
    .hero-eyebrow {
      letter-spacing: 0.15rem;
    }
  }
</style>
