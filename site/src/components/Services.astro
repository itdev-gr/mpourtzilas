---
const services = [
  {
    n: "01",
    title: "ΑΝΕΓΕΡΣΗ",
    en: "Νέες οικοδομές",
    body:
      "Ανέγερση νέων πολυκατοικιών και κατοικιών, από τη μελέτη και την αδειοδότηση έως τον φέροντα οργανισμό και την τοιχοποιία.",
    items: ["Μελέτη & άδεια", "Φέρων οργανισμός", "Τοιχοποιία & μονώσεις"],
  },
  {
    n: "02",
    title: "ΔΟΜΗΣΗ",
    en: "Σύγχρονες μέθοδοι",
    body:
      "Σύγχρονες μέθοδοι δόμησης και ενεργειακή απόδοση κατά ΚΕΝΑΚ, με επώνυμους προμηθευτές και έμπειρα συνεργεία υψηλής κατάρτισης.",
    items: ["Ενεργειακή απόδοση", "Ποιοτικά υλικά", "Ηλεκτρομηχανολογικά"],
  },
  {
    n: "03",
    title: "ΠΑΡΑΔΟΣΗ",
    en: "Κλειδί στο χέρι",
    body:
      "Ολοκληρωμένα φινιρίσματα, τελικός έλεγχος ποιότητας και παράδοση της κατοικίας έτοιμης προς χρήση.",
    items: ["Φινιρίσματα", "Έλεγχος ποιότητας", "Κλειδί στο χέρι"],
  },
];
---

<section id="services" class="services section section--inverse">
  <div class="services-head">
    <span class="eyebrow" data-reveal>
      Η ΥΠΗΡΕΣΙΑ ΜΑΣ <span class="eyebrow-line"></span>
    </span>
    <h2 class="section-title" data-split-title>
      <span class="line">ΚΑΤΑΣΚΕΥΕΣ</span>
    </h2>
    <p class="services-lede body-copy" data-reveal>
      Εξειδικευόμαστε αποκλειστικά στην ανέγερση νέων οικοδομών, από τη μελέτη
      έως την παράδοση με το κλειδί στο χέρι.
    </p>
  </div>

  <ol class="services-list" data-services>
    {services.map((s, i) => (
      <li class="svc" data-svc style={`--idx:${i}`}>
        <span class="svc-num">{s.n}</span>
        <div class="svc-body">
          <span class="svc-en">{s.en}</span>
          <h3 class="svc-title">{s.title}</h3>
          <p>{s.body}</p>
          <ul class="svc-items">
            {s.items.map((it) => (
              <li>
                <span class="bullet"></span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
        <span class="svc-rule"></span>
      </li>
    ))}
  </ol>

  <div class="services-cta">
    <a class="btn-outline" href="/services">ΟΛΗ Η ΥΠΗΡΕΣΙΑ</a>
  </div>
</section>

<style>
  .services-head {
    max-width: var(--content-max);
    margin: 0 auto clamp(3rem, 5vw, 4.5rem);
  }
  .services-head .eyebrow { margin-bottom: 1.5rem; color: var(--canvas); }
  .services-head .eyebrow-line { background: var(--canvas); }
  .services-head .section-title { color: var(--canvas); }
  .services-lede { max-width: 32rem; color: #fff; }

  .services-list {
    max-width: var(--content-max);
    margin: 0 auto;
    list-style: none;
    padding: 0;
    counter-reset: svc;
  }

  .svc {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(2.5rem, 5vw, 3.75rem) 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    position: relative;
  }
  .svc:last-child { border-bottom: 1px solid rgba(255,255,255,0.1); }

  .svc-num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    letter-spacing: 0.04em;
    color: var(--bronze);
    line-height: 1;
  }

  .svc-body {
    max-width: 36rem;
  }
  .svc-body .svc-en {
    display: block;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--canvas);
    text-transform: none;
    margin-bottom: 0.875rem;
  }
  .svc-title {
    margin: 0 0 1.1rem 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    letter-spacing: var(--tracking-section);
    text-transform: uppercase;
    color: var(--canvas);
  }
  .svc p {
    margin: 0 0 1.5rem 0;
    color: #fff;
    line-height: 1.85;
    max-width: 32rem;
  }
  .svc-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .svc-items li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #fff;
    text-transform: none;
  }
  .svc-items .bullet {
    width: 6px; height: 6px; background: var(--bronze);
  }

  /* Hairline that sweeps in on hover */
  .svc-rule {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--bronze);
    transition: width 0.7s var(--ease-arch);
  }
  .svc:hover .svc-rule { width: 100%; }

  .services-cta {
    max-width: var(--content-max);
    margin: clamp(2.5rem, 5vw, 3.75rem) auto 0;
    text-align: center;
  }

  @media (max-width: 720px) {
    .svc { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .svc-num { font-size: 2rem; }
    /* ΗΛΕΚΤΡΟΜΗΧΑΝΟΛΟΓΙΚΑ at 9px tracking is wider than a small phone */
    .svc-items { gap: 0.5rem 1.25rem; }
  }
</style>
