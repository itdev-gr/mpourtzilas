---
---

<section id="contact" class="contact section">
  <div class="contact-grid">
    <div class="contact-text">
      <span class="eyebrow" data-reveal>
        Get in touch <span class="eyebrow-line"></span>
      </span>
      <h2 class="section-title" data-split-title>
        <span class="line">ΕΠΙΚΟΙΝΩΝΗΣΤΕ</span>
        <span class="line">ΜΑΖΙ ΜΑΣ</span>
      </h2>
      <p class="body-copy" data-reveal>
        Πείτε μας για το έργο σας. Απαντάμε εντός μιας εργάσιμης ημέρας —
        στα Ελληνικά ή στα Αγγλικά.
      </p>

      <ul class="contact-list" data-reveal-stagger>
        <li>
          <span class="ck">Address</span>
          <span class="cv">Marathonodromou 59 · 151 24 Marousi · Athens</span>
        </li>
        <li>
          <span class="ck">Phone</span>
          <span class="cv">+30 210 000 0059</span>
        </li>
        <li>
          <span class="ck">Email</span>
          <span class="cv">studio@mpourtzilas.gr</span>
        </li>
        <li>
          <span class="ck">Hours</span>
          <span class="cv">Mon–Fri · 09:00 — 18:00</span>
        </li>
      </ul>
    </div>

    <form class="contact-form" data-reveal onsubmit="event.preventDefault(); this.querySelector('button').textContent='SENT · ΕΥΧΑΡΙΣΤΟΥΜΕ';">
      <span class="contact-form__corner contact-form__corner--tl" aria-hidden="true"></span>
      <span class="contact-form__corner contact-form__corner--br" aria-hidden="true"></span>
      <p class="contact-form__lede">Συμπληρώστε τη φόρμα και θα επικοινωνήσουμε εντός μιας εργάσιμης ημέρας.</p>
      <div class="field">
        <label for="name">Ονοματεπώνυμο</label>
        <input id="name" name="name" type="text" required autocomplete="name" placeholder="Ονοματεπώνυμο" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="name@example.com" />
      </div>
      <div class="field">
        <label for="kind">Είδος έργου</label>
        <select id="kind" name="kind">
          <option>Ανακαίνιση</option>
          <option>Κατασκευή</option>
          <option>Σχεδιασμός &amp; Διακόσμηση</option>
          <option>Άλλο</option>
        </select>
      </div>
      <div class="field field--full">
        <label for="msg">Πείτε μας για τον χώρο σας</label>
        <textarea id="msg" name="msg" rows="4" required placeholder="Σύντομη περιγραφή — τοποθεσία, εμβαδόν, χρονοδιάγραμμα…"></textarea>
      </div>
      <button class="contact-form__submit" type="submit">
        <span>ΑΠΟΣΤΟΛΗ ΑΙΤΗΜΑΤΟΣ</span>
        <span class="arrow" aria-hidden="true">→</span>
      </button>
    </form>
  </div>

  <footer class="footer">
    <span>© 2026 · MPOURTZILAS O.E.</span>
    <span class="rule"></span>
    <span>Powered by <a href="https://www.itdev.gr">itdev</a></span>
  </footer>
</section>

<style>
  .contact-grid {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .contact-text .eyebrow { margin-bottom: 1.5rem; }
  .contact-text .body-copy { max-width: 32rem; }

  .contact-list {
    list-style: none;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
  }
  .contact-list li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid rgba(0,0,0,0.08);
    align-items: baseline;
  }
  .contact-list li:last-child { border-bottom: 1px solid rgba(0,0,0,0.08); }
  .ck {
    font-family: var(--font-display);
    font-size: 0.5625rem;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--bronze);
    text-transform: uppercase;
  }
  .cv {
    font-family: var(--font-body);
    color: var(--ink);
    font-size: 0.95rem;
  }

  /* ---- Form ---- */
  .contact-form {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem 1.5rem;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    background: var(--whisper, #fafafa);
    border: 1px solid rgba(0,0,0,0.08);
  }
  .contact-form__corner {
    position: absolute;
    width: 2.25rem; height: 2.25rem;
    border-color: var(--bronze);
    border-style: solid;
    pointer-events: none;
  }
  .contact-form__corner--tl { top: -1px; left: -1px; border-width: 1px 0 0 1px; }
  .contact-form__corner--br { bottom: -1px; right: -1px; border-width: 0 1px 1px 0; }
  .contact-form__lede {
    grid-column: 1 / -1;
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(39,39,39,0.78);
  }
  .field { display: flex; flex-direction: column; }
  .field--full { grid-column: 1 / -1; }
  .field label {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink);
    text-transform: uppercase;
    margin-bottom: 0.55rem;
    font-weight: 500;
  }
  .field input,
  .field select,
  .field textarea {
    background: var(--canvas);
    border: 1px solid rgba(0,0,0,0.14);
    border-radius: 0;
    padding: 0.85rem 0.95rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    transition: border-color 0.35s var(--ease-arch), box-shadow 0.35s var(--ease-arch), background 0.35s var(--ease-arch);
    appearance: none;
  }
  .field select {
    background-image: linear-gradient(45deg, transparent 50%, var(--bronze) 50%),
                      linear-gradient(135deg, var(--bronze) 50%, transparent 50%);
    background-position: calc(100% - 1.05rem) 50%, calc(100% - 0.75rem) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }
  .field input::placeholder,
  .field textarea::placeholder { color: rgba(39,39,39,0.4); }
  .field textarea { resize: vertical; min-height: 7.5rem; line-height: 1.55; }
  .field input:hover,
  .field select:hover,
  .field textarea:hover { border-color: rgba(0,0,0,0.28); }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--bronze);
    box-shadow: 0 0 0 3px rgba(177,151,119,0.18);
  }
  .contact-form__submit {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
    padding: 1rem 1.75rem;
    background: var(--ink);
    color: var(--canvas);
    border: 1px solid var(--ink);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.35s var(--ease-arch), color 0.35s var(--ease-arch), letter-spacing 0.45s var(--ease-arch), transform 0.35s var(--ease-arch);
  }
  .contact-form__submit .arrow {
    color: var(--bronze);
    transition: transform 0.35s var(--ease-arch);
  }
  .contact-form__submit:hover {
    background: var(--bronze);
    border-color: var(--bronze);
    color: var(--ink);
    letter-spacing: calc(var(--tracking-eyebrow) + 0.1rem);
  }
  .contact-form__submit:hover .arrow { color: var(--ink); transform: translateX(4px); }

  @media (max-width: 600px) {
    .contact-form { grid-template-columns: 1fr; padding: 1.5rem; }
    .contact-list li { grid-template-columns: 1fr; gap: 0.25rem; }
  }

  /* ---- Footer ---- */
  .footer {
    max-width: var(--content-max);
    margin: clamp(4rem, 6vw, 5rem) auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: 0.5625rem;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--slate);
    text-transform: uppercase;
    flex-wrap: wrap;
  }
  .footer .rule { flex: 1 1 3rem; height: 1px; background: rgba(0,0,0,0.12); min-width: 1.5rem; }
  .footer a { color: inherit; }
</style>
