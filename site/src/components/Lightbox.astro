---
// Collects every project gallery image on the page and lets the visitor
// expand them with prev/next + keyboard navigation.
---

<div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Προβολή εικόνων έργου">
  <button class="lightbox__close" type="button" data-lb-close aria-label="Κλείσιμο">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label="Προηγούμενη εικόνα">&lsaquo;</button>

  <figure class="lightbox__stage">
    <img class="lightbox__img" data-lb-img alt="" decoding="async" />
    <figcaption class="lightbox__caption" data-lb-caption></figcaption>
  </figure>

  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label="Επόμενη εικόνα">&rsaquo;</button>
  <span class="lightbox__count" data-lb-count aria-hidden="true"></span>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(14, 14, 14, 0.93);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    padding: clamp(1rem, 4vw, 3rem);
    animation: lb-fade 0.32s var(--ease-arch);
  }
  .lightbox[hidden] { display: none; }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }

  .lightbox__stage {
    margin: 0;
    max-width: min(92vw, 1400px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
    background: #1e1e1e;
  }
  .lightbox__caption {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.66);
    text-align: center;
    max-width: 64ch;
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s var(--ease-arch), border-color 0.3s var(--ease-arch), transform 0.3s var(--ease-arch);
  }
  .lightbox__close:hover,
  .lightbox__nav:hover { background: rgba(255, 255, 255, 0.18); border-color: rgba(255, 255, 255, 0.45); }

  .lightbox__close {
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    width: 3rem;
    height: 3rem;
    font-size: 1.7rem;
    line-height: 1;
  }
  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3.25rem;
    height: 3.25rem;
    font-size: 2.1rem;
    line-height: 1;
    padding-bottom: 0.2rem;
  }
  .lightbox__nav:hover { transform: translateY(-50%) scale(1.06); }
  .lightbox__nav--prev { left: clamp(0.75rem, 3vw, 2.25rem); }
  .lightbox__nav--next { right: clamp(0.75rem, 3vw, 2.25rem); }

  .lightbox__count {
    position: absolute;
    bottom: clamp(1rem, 3vw, 2rem);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-eyebrow);
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 600px) {
    .lightbox__nav { width: 2.6rem; height: 2.6rem; font-size: 1.7rem; }
    .lightbox__img { max-height: 72vh; }
  }
</style>

<script>
  const lb = document.querySelector<HTMLElement>("[data-lightbox]");
  if (lb) {
    const imgEl = lb.querySelector("[data-lb-img]") as HTMLImageElement;
    const capEl = lb.querySelector("[data-lb-caption]") as HTMLElement;
    const countEl = lb.querySelector("[data-lb-count]") as HTMLElement;
    const shots = Array.from(
      document.querySelectorAll<HTMLImageElement>(".project-card__shot img"),
    );
    const items = shots.map((im) => ({ src: im.currentSrc || im.src, alt: im.alt || "" }));
    let idx = 0;

    const render = () => {
      const it = items[idx];
      imgEl.src = it.src;
      imgEl.alt = it.alt;
      capEl.textContent = it.alt;
      countEl.textContent = `${idx + 1} / ${items.length}`;
    };
    const open = (i: number) => {
      idx = i;
      render();
      lb.hidden = false;
      lb.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      lb.hidden = true;
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };
    const next = () => { idx = (idx + 1) % items.length; render(); };
    const prev = () => { idx = (idx - 1 + items.length) % items.length; render(); };

    shots.forEach((im, i) => {
      im.style.cursor = "zoom-in";
      im.addEventListener("click", () => open(i));
    });
    lb.querySelector("[data-lb-close]")?.addEventListener("click", close);
    lb.querySelector("[data-lb-next]")?.addEventListener("click", next);
    lb.querySelector("[data-lb-prev]")?.addEventListener("click", prev);
    lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") next();
      else if (e.key === "ArrowLeft") prev();
    });
  }
</script>
