---
const nav = [
  { label: "Αρχική", href: "/" },
  { label: "Εταιρεία", href: "/about" },
  { label: "Τα Έργα μας", href: "/projects" },
  { label: "Υπηρεσίες", href: "/services" },
  { label: "Επικοινωνία", href: "/contact" },
];
const services = ["Ανέγερση νέων οικοδομών", "Σύγχρονη δόμηση", "Παράδοση κλειδί στο χέρι"];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label="ΜΠΟΥΡΤΖΙΛΑΣ ΠΑΝΑΓΙΩΤΗΣ, Αρχική">
        <img
          src="/brand/logo-white.png"
          alt="ΟΜΙΛΟΣ ΟΙΚΟΔΟΜΙΚΩΝ ΕΠΙΧΕΙΡΗΣΕΩΝ, ΜΠΟΥΡΤΖΙΛΑΣ ΠΑΝΑΓΙΩΤΗΣ"
          width="1120"
          height="265"
          loading="lazy"
        />
      </a>
      <p class="site-footer__desc">
        Ανέγερση νέων οικοδομών υψηλής ποιότητας στην Αθήνα από το 1995, με
        έμφαση στη σύγχρονη δόμηση, τις νέες τεχνολογίες και την ανθεκτικότητα.
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Πλοήγηση">
      <h3 class="site-footer__h">Πλοήγηση</h3>
      <ul>
        {nav.map((n) => (
          <li><a href={n.href}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col">
      <h3 class="site-footer__h">Υπηρεσίες</h3>
      <ul>
        {services.map((s) => (
          <li><a href="/services">{s}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col site-footer__col--contact">
      <h3 class="site-footer__h">Επικοινωνία</h3>
      <ul>
        <li>
          <span class="k">Διεύθυνση</span>
          <span>Μητσάκη 32 · Κυπριάδου · 111 41 Αθήνα</span>
        </li>
        <li>
          <span class="k">Τηλέφωνο</span>
          <a href="tel:+302102116052">+30 210 211 6052</a>
          <a href="tel:+306972667663">+30 697 266 7663</a>
        </li>
        <li>
          <span class="k">Email</span>
          <a href="mailto:pmpourtzilas@gmail.com">pmpourtzilas@gmail.com</a>
        </li>
        <li>
          <span class="k">Ώρες</span>
          <span>Δευτέρα – Παρασκευή · 09:00 έως 18:00</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bar">
    <span>© 2026 · MPOURTZILAS O.E.</span>
    <span class="site-footer__sep" aria-hidden="true"></span>
    <span class="site-footer__credit">
      Developed by <a href="https://www.itdev.gr" target="_blank" rel="noopener">IT DEV</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    background: #1e1e1e;
    color: #fff;
    padding: clamp(3.5rem, 7vw, 5.5rem) clamp(2rem, 6vw, 6rem) clamp(1.75rem, 3vw, 2.5rem);
  }

  .site-footer__inner {
    width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.5fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  /* Brand */
  .site-footer__logo { display: inline-block; }
  .site-footer__logo img {
    display: block;
    width: min(380px, 100%);
    height: auto;
  }
  .site-footer__desc {
    margin: 1.5rem 0 0;
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: #fff;
  }

  /* Columns */
  .site-footer__h {
    margin: 0 0 1.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: #fff;
  }
  .site-footer__col ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__col li { margin-bottom: 0.9rem; }
  .site-footer__col a,
  .site-footer__col li > span {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.6;
    color: #fff;
    transition: color 0.35s var(--ease-arch);
  }
  .site-footer__col a:hover { color: var(--bronze-soft); }

  .site-footer__col--contact li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }
  .site-footer__col--contact .k {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: #fff;
  }

  /* Bottom bar */
  .site-footer__bar {
    width: 100%;
    margin: clamp(2.75rem, 5vw, 4rem) 0 0;
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid #fff;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: #fff;
  }
  .site-footer__sep { flex: 1; height: 1px; background: #fff; }
  .site-footer__credit a { color: var(--bronze-soft); }
  .site-footer__credit a:hover { color: #fff; }

  @media (max-width: 860px) {
    .site-footer__inner { grid-template-columns: 1fr 1fr; gap: 2.25rem; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .site-footer__inner { grid-template-columns: 1fr; }
    .site-footer__bar {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.7rem;
    }
    .site-footer__sep { display: none; }
  }
</style>
