---
const items = [
  { label: "ΑΡΧΙΚΗ",       href: "/" },
  { label: "ΕΤΑΙΡΕΙΑ",     href: "/about" },
  { label: "ΤΑ ΕΡΓΑ ΜΑΣ",  href: "/projects" },
  { label: "ΥΠΗΡΕΣΙΕΣ",    href: "/services" },
  { label: "ΕΠΙΚΟΙΝΩΝΙΑ",  href: "/contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class:list={["topbar", { "is-over-hero": path === "/" }]} data-rail>
  <a href="/" class="brand" aria-label="ΜΠΟΥΡΤΖΙΛΑΣ ΠΑΝΑΓΙΩΤΗΣ — Αρχική">
    <img
      class="brand-logo brand-logo--dark"
      src="/brand/logo-dark.png"
      alt="ΟΜΙΛΟΣ ΟΙΚΟΔΟΜΙΚΩΝ ΕΠΙΧΕΙΡΗΣΕΩΝ — ΜΠΟΥΡΤΖΙΛΑΣ ΠΑΝΑΓΙΩΤΗΣ"
      width="1120"
      height="265"
    />
    <img
      class="brand-logo brand-logo--white"
      src="/brand/logo-white.png"
      alt=""
      aria-hidden="true"
      width="1120"
      height="265"
    />
  </a>

  <nav class="topbar-nav" aria-label="Primary">
    <ul>
      {items.map((it, i) => {
        const isActive = it.href === path;
        return (
          <li style={`--i:${i}`}>
            <a
              href={it.href}
              data-nav-link
              class={isActive ? "is-active" : undefined}
              aria-current={isActive ? "page" : undefined}
            >{it.label}</a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="topbar-end">
    <div class="lang-toggle" role="group" aria-label="Γλώσσα / Language" data-lang-toggle>
      <button class="lang-opt is-active" type="button" data-lang="el" aria-pressed="true">EL</button>
      <span class="lang-sep" aria-hidden="true">/</span>
      <button class="lang-opt" type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <a class="topbar-cta" href="/contact">
      <span>ΕΠΙΚΟΙΝΩΝΙΑ</span>
      <span class="arrow">→</span>
    </a>
    <button class="topbar-burger" aria-label="Open menu" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(10px) saturate(1.05);
    -webkit-backdrop-filter: blur(10px) saturate(1.05);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 0.85rem clamp(1.25rem, 4vw, 3rem);
  }

  /* ---- Brand ---- */
  .brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .brand-logo {
    height: 48px;
    width: auto;
    display: block;
    transition: opacity 0.45s var(--ease-arch);
  }
  .brand-logo--white {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    opacity: 0;
  }

  /* ---- Nav ---- */
  .topbar-nav {
    justify-self: center;
  }
  .topbar-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 2.25rem);
  }
  .topbar-nav a {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: var(--ink);
    padding: 0.4rem 0;
    white-space: nowrap;
    transition: color 0.4s var(--ease-arch), letter-spacing 0.5s var(--ease-arch);
  }
  .topbar-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--bronze);
    transition: width 0.55s var(--ease-arch);
  }
  .topbar-nav a:hover {
    color: var(--bronze);
    letter-spacing: 0.25rem;
  }
  .topbar-nav a:hover::after { width: 100%; }
  .topbar-nav a.is-active {
    color: var(--bronze);
  }
  .topbar-nav a.is-active::after { width: 100%; }

  /* ---- End cluster ---- */
  .topbar-end {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .topbar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink);
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--ink);
    transition: background-color 0.4s var(--ease-arch), color 0.4s var(--ease-arch), letter-spacing 0.5s var(--ease-arch);
  }
  .topbar-cta:hover {
    background: var(--ink);
    color: var(--canvas);
    letter-spacing: 0.65rem;
  }
  .topbar-cta .arrow {
    color: var(--bronze);
    transition: transform 0.4s var(--ease-arch);
  }
  .topbar-cta:hover .arrow { transform: translateX(3px); }

  .topbar-burger {
    display: none;
    width: 36px;
    height: 36px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    background: transparent;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .topbar-burger span {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--ink);
    transition: transform 0.35s var(--ease-arch), opacity 0.25s var(--ease-arch);
  }
  /* Open state: burger becomes an X */
  .topbar.is-menu-open .topbar-burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .topbar.is-menu-open .topbar-burger span:nth-child(2) { opacity: 0; }
  .topbar.is-menu-open .topbar-burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ---- Language toggle ---- */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.12rem;
  }
  .lang-opt {
    color: var(--slate);
    padding: 0.2rem 0.15rem;
    line-height: 1;
    transition: color 0.35s var(--ease-arch);
  }
  .lang-opt.is-active { color: var(--ink); }
  .lang-opt:hover { color: var(--bronze); }
  .lang-sep { color: rgba(0,0,0,0.22); }

  /* ---- Over-hero (home): transparent until scrolled ---- */
  .topbar.is-over-hero {
    position: fixed;
    left: 0;
    right: 0;
    transition: background-color 0.45s var(--ease-arch),
                border-color 0.45s var(--ease-arch),
                backdrop-filter 0.45s var(--ease-arch);
  }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0));
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .brand-logo--dark { opacity: 0; }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .brand-logo--white { opacity: 1; }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .topbar-nav a { color: rgba(255,255,255,0.92); }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .topbar-nav a.is-active { color: var(--bronze-soft); }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .topbar-cta {
    color: #fff;
    border-color: rgba(255,255,255,0.5);
  }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .topbar-cta:hover { background: #fff; color: var(--ink); }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .lang-opt { color: rgba(255,255,255,0.65); }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .lang-opt.is-active { color: #fff; }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .lang-sep { color: rgba(255,255,255,0.4); }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .topbar-burger { border-color: rgba(255,255,255,0.4); }
  .topbar.is-over-hero:not(.is-solid):not(.is-menu-open) .topbar-burger span { background: #fff; }

  /* ---- Responsive ---- */
  @media (max-width: 1100px) {
    .topbar-nav a { font-size: 0.72rem; letter-spacing: 0.16rem; }
    .topbar-nav ul { gap: 1.2rem; }
    .topbar-cta { display: none; }
  }
  @media (max-width: 860px) {
    .topbar { grid-template-columns: 1fr auto; padding: 0.75rem 1.25rem; }
    .brand-logo { height: 38px; }
    /* Single header row: brand left, lang+burger right; nav drops below */
    .brand { grid-row: 1; grid-column: 1; }
    .topbar-end { grid-row: 1; grid-column: 2; justify-self: end; }
    .topbar-nav {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: stretch;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s var(--ease-arch);
    }
    .topbar-nav.is-open { max-height: 480px; }
    .topbar-nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 1rem 0 0.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      margin-top: 0.6rem;
    }
    .topbar-burger { display: inline-flex; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const nav = document.querySelector<HTMLElement>(".topbar-nav");
  const topbar = document.querySelector<HTMLElement>(".topbar");
  burger?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    // Solid background while the menu is open (links are unreadable over the hero video)
    topbar?.classList.toggle("is-menu-open", open);
  });
  // Auto-close on link click (mobile)
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      nav?.classList.remove("is-open");
      topbar?.classList.remove("is-menu-open");
    }),
  );
</script>
