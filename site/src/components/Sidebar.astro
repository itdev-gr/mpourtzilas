---
const items = [
  { label: "ΑΡΧΙΚΗ",       href: "/" },
  { label: "ΕΤΑΙΡΕΙΑ",     href: "/about" },
  { label: "ΤΑ ΕΡΓΑ ΜΑΣ",  href: "/projects" },
  { label: "ΥΠΗΡΕΣΙΕΣ",    href: "/services" },
  { label: "ΕΠΙΚΟΙΝΩΝΙΑ",  href: "/contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class:list={["topbar", { "is-over-hero": path === "/" }]} data-rail>
  <a href="/" class="brand" aria-label="MPOURTZILAS — home">
    <svg
      class="brand-mark"
      viewBox="0 0 220 110"
      role="img"
      aria-hidden="true"
    >
      <g stroke="var(--bronze)" stroke-width="1.4" fill="none" stroke-linejoin="miter" stroke-linecap="square">
        <path d="M115 10 L115 32 L130 32 L130 14 L150 14 L150 36 L165 36 L165 22 L182 22 L182 44 L160 44" />
        <path d="M165 22 L165 44" />
        <path d="M150 36 L150 44" />
        <path d="M130 14 L130 32" />
      </g>
    </svg>
    <span class="brand-block">
      <span class="brand-word"><em>MPOUR</em><strong>TZIL</strong><em>AS</em></span>
      <span class="brand-tag">
        <span>ΤΕΧΝΙΚΗ</span><span class="dot">·</span><span>ΕΤΑΙΡΕΙΑ</span>
      </span>
    </span>
  </a>

  <nav class="topbar-nav" aria-label="Primary">
    <ul>
      {items.map((it, i) => {
        const isActive = it.href === path;
        return (
          <li style={`--i:${i}`}>
            <a
              href={it.href}
              data-nav-link
              class={isActive ? "is-active" : undefined}
              aria-current={isActive ? "page" : undefined}
            >{it.label}</a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="topbar-end">
    <div class="lang-toggle" role="group" aria-label="Γλώσσα / Language" data-lang-toggle>
      <button class="lang-opt is-active" type="button" data-lang="el" aria-pressed="true">EL</button>
      <span class="lang-sep" aria-hidden="true">/</span>
      <button class="lang-opt" type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <a class="topbar-cta" href="/contact">
      <span>ΕΠΙΚΟΙΝΩΝΙΑ</span>
      <span class="arrow">→</span>
    </a>
    <button class="topbar-burger" aria-label="Open menu" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(10px) saturate(1.05);
    -webkit-backdrop-filter: blur(10px) saturate(1.05);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 0.85rem clamp(1.25rem, 4vw, 3rem);
  }

  /* ---- Brand ---- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }
  .brand-mark {
    width: 56px;
    height: auto;
    display: block;
    margin-top: -2px;
  }
  .brand-block {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  .brand-word {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.55rem;
    letter-spacing: -0.4px;
    color: var(--bronze);
    line-height: 1;
  }
  .brand-word em { font-style: normal; font-weight: 300; }
  .brand-word strong { font-weight: 500; color: var(--bronze); }
  .brand-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.32rem;
    color: var(--bronze);
    font-family: var(--font-display);
    font-size: 0.5rem;
    letter-spacing: 0.4rem;
    text-transform: uppercase;
  }
  .brand-tag .dot { opacity: 0.55; }

  /* ---- Nav ---- */
  .topbar-nav {
    justify-self: center;
  }
  .topbar-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 2.25rem);
  }
  .topbar-nav a {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    color: var(--ink);
    padding: 0.4rem 0;
    white-space: nowrap;
    transition: color 0.4s var(--ease-arch), letter-spacing 0.5s var(--ease-arch);
  }
  .topbar-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--bronze);
    transition: width 0.55s var(--ease-arch);
  }
  .topbar-nav a:hover {
    color: var(--bronze);
    letter-spacing: 0.25rem;
  }
  .topbar-nav a:hover::after { width: 100%; }
  .topbar-nav a.is-active {
    color: var(--bronze);
  }
  .topbar-nav a.is-active::after { width: 100%; }

  /* ---- End cluster ---- */
  .topbar-end {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .topbar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink);
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--ink);
    transition: background-color 0.4s var(--ease-arch), color 0.4s var(--ease-arch), letter-spacing 0.5s var(--ease-arch);
  }
  .topbar-cta:hover {
    background: var(--ink);
    color: var(--canvas);
    letter-spacing: 0.65rem;
  }
  .topbar-cta .arrow {
    color: var(--bronze);
    transition: transform 0.4s var(--ease-arch);
  }
  .topbar-cta:hover .arrow { transform: translateX(3px); }

  .topbar-burger {
    display: none;
    width: 36px;
    height: 36px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    background: transparent;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .topbar-burger span {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--ink);
  }

  /* ---- Language toggle ---- */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.12rem;
  }
  .lang-opt {
    color: var(--slate);
    padding: 0.2rem 0.15rem;
    line-height: 1;
    transition: color 0.35s var(--ease-arch);
  }
  .lang-opt.is-active { color: var(--ink); }
  .lang-opt:hover { color: var(--bronze); }
  .lang-sep { color: rgba(0,0,0,0.22); }

  /* ---- Over-hero (home): transparent until scrolled ---- */
  .topbar.is-over-hero {
    position: fixed;
    left: 0;
    right: 0;
    transition: background-color 0.45s var(--ease-arch),
                border-color 0.45s var(--ease-arch),
                backdrop-filter 0.45s var(--ease-arch);
  }
  .topbar.is-over-hero:not(.is-solid) {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0));
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .topbar.is-over-hero:not(.is-solid) .topbar-nav a { color: rgba(255,255,255,0.92); }
  .topbar.is-over-hero:not(.is-solid) .topbar-nav a.is-active { color: var(--bronze-soft); }
  .topbar.is-over-hero:not(.is-solid) .topbar-cta {
    color: #fff;
    border-color: rgba(255,255,255,0.5);
  }
  .topbar.is-over-hero:not(.is-solid) .topbar-cta:hover { background: #fff; color: var(--ink); }
  .topbar.is-over-hero:not(.is-solid) .lang-opt { color: rgba(255,255,255,0.65); }
  .topbar.is-over-hero:not(.is-solid) .lang-opt.is-active { color: #fff; }
  .topbar.is-over-hero:not(.is-solid) .lang-sep { color: rgba(255,255,255,0.4); }
  .topbar.is-over-hero:not(.is-solid) .topbar-burger { border-color: rgba(255,255,255,0.4); }
  .topbar.is-over-hero:not(.is-solid) .topbar-burger span { background: #fff; }

  /* ---- Responsive ---- */
  @media (max-width: 1100px) {
    .topbar-nav a { font-size: 0.72rem; letter-spacing: 0.16rem; }
    .topbar-nav ul { gap: 1.2rem; }
    .topbar-cta { display: none; }
  }
  @media (max-width: 860px) {
    .topbar { grid-template-columns: 1fr auto; padding: 0.75rem 1.25rem; }
    .brand-mark { width: 44px; }
    .brand-word { font-size: 1.25rem; }
    .topbar-nav {
      grid-column: 1 / -1;
      justify-self: stretch;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s var(--ease-arch);
    }
    .topbar-nav.is-open { max-height: 480px; }
    .topbar-nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 1rem 0 0.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      margin-top: 0.6rem;
    }
    .topbar-burger { display: inline-flex; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const nav = document.querySelector<HTMLElement>(".topbar-nav");
  burger?.addEventListener("click", () => {
    nav?.classList.toggle("is-open");
  });
  // Auto-close on link click (mobile)
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => nav?.classList.remove("is-open")),
  );
</script>
