---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import CompletedProjects from "../components/about/CompletedProjects.astro";
import UnderConstructionProjects from "../components/about/UnderConstructionProjects.astro";
import Lightbox from "../components/Lightbox.astro";
---

<Layout title="ΤΑ ΕΡΓΑ ΜΑΣ | MPOURTZILAS">
  <div class="shell">
    <Sidebar />
    <main class="stage">
      <UnderConstructionProjects />
      <CompletedProjects />
    </main>
  </div>

  <Lightbox />

  <script>
    import "../scripts/main.ts";
    import { initLightbox } from "../scripts/lightbox.ts";

    const bootLightbox = () => initLightbox();
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootLightbox);
    } else {
      bootLightbox();
    }
  </script>
</Layout>
