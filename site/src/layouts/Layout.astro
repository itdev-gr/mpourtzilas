---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MPOURTZILAS — Ανέγερση Νέων Οικοδομών στην Αθήνα",
  description = "Η MPOURTZILAS εξειδικεύεται στην ανέγερση νέων οικοδομών στην Αθήνα από το 1995 — από τη μελέτη έως την παράδοση με το κλειδί στο χέρι.",
} = Astro.props;
---

<!doctype html>
<html lang="el" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Typography: Helvetica system stack (no web-font load needed) -->

    <script is:inline>
      // Replace no-js as early as possible
      document.documentElement.classList.remove("no-js");
    </script>
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
